# gate-generic.rules — PUBLIC shape rules for crossing-lint.sh (one ERE per line, matched case-insensitively).
# No owner literal lives here: this file is exported verbatim as tools/gate-generic.rules and is the only file,
# together with gitleaks.toml, that is exempt from its own gate (by file name). Identity literals live in the
# off-repo list named by CROSSING_LINT_TOKENS (never tracked).
#
# Private address space (RFC 1918 + the carrier-grade range used by mesh VPNs)
\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b
\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b
\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b
\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b
# Mesh-VPN magic DNS names and .local/.lan/.home(.arpa) hostnames. The suffix must end at a non-label character or a
# sentence dot (D24, 2026-11-05): "settings.local.json" and "home-" style labels are not hostnames.
[a-z0-9-]+\.ts\.net\b
\b[a-z0-9-]+\.(local|lan|home)(\.?([^.[:alnum:]_-]|$))
\b[a-z0-9-]+\.home\.arpa\b
# Credential shapes (hard-fail classes: a hit is a selection error, never something to rewrite)
api/push/[A-Za-z0-9_-]{8,}
webhook/[A-Za-z0-9_-]{24,}
\btskey-[A-Za-z0-9_-]+
-----BEGIN [A-Z ]*PRIVATE KEY-----
\bsk-[A-Za-z0-9_-]{16,}
\bBearer [A-Za-z0-9._~+/=-]{16,}
\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}
\bgh[opusr]_[A-Za-z0-9]{20,}
\bgithub_pat_[A-Za-z0-9_]{20,}
\bAKIA[0-9A-Z]{16}\b
\bxox[baprs]-[A-Za-z0-9-]{10,}
\b[0-9]{8,10}:[A-Za-z0-9_-]{35}\b
\b(password|passwd|secret|token|api_?key|access_?key)[A-Za-z_]*[ ]*[:=][ ]*["']?[A-Za-z0-9_/+=-]{16,}
# Personal e-mail at a consumer provider (the project identity is a noreply address)
[A-Za-z0-9._%+-]+@(gmail|googlemail|outlook|hotmail|live|yahoo|proton|protonmail|icloud)\.[a-z]{2,}
# Machine fingerprints and SSH key blobs
\bSHA256:[A-Za-z0-9+/]{43}=?([^A-Za-z0-9+/=]|$)
\bssh-(ed25519|rsa|ecdsa)[ ]+AAAA[A-Za-z0-9+/]{20,}
