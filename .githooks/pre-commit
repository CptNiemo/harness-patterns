#!/usr/bin/env bash
# pre-commit for the PUBLIC clone of harness-patterns. Installed by `git config core.hooksPath .githooks`.
# Every commit here is produced by the private lane's publish script; this hook is the belt over those braces:
# identity, secrets and crossing literals are re-checked on the exact blobs being committed. Exit 2 = refused.
# 2026-11-06 (blind-review findings): identity is read as git will RECORD it, for author AND committer, so --author,
# `git -c` and the GIT_* variables count; the name rule is the same for every commit (a handle, never an address or
# hostname); type changes are included; the secret scan runs `gitleaks stdin` over the staged blobs, because
# `gitleaks git --pre-commit --staged` reads its own `git diff`, which `color.ui=always` blinds (exit 1 -> 0, tested).
# The lint's address rules make the old separate added-lines grep redundant; it is gone.
# 2026-11-07: the identity regexes moved to tools/identity.rules (one copy for every reader).
# Needs bash >= 4 (lower-casing); GNU coreutils; gitleaks >= 8.19 (stdin/dir modes); git >= 2.31.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
# the identity rule lives in tools/identity.rules — one file for this hook, pre-push, the preflight and the lane — read
# from HEAD so a commit cannot loosen the rule that judges it; a commit with no HEAD copy yet (the root commit, the publish
# that first ships the file) is judged by the STAGED copy, the one being committed — never the working tree
if git cat-file -e HEAD:tools/identity.rules 2>/dev/null; then git cat-file blob HEAD:tools/identity.rules > "$TMP/identity.rules"
elif git cat-file -e :tools/identity.rules 2>/dev/null; then git cat-file blob :tools/identity.rules > "$TMP/identity.rules"
else echo "pre-commit: tools/identity.rules is neither in HEAD nor staged — refusing" >&2; exit 2; fi
rc=0; grep -qa $'\r' "$TMP/identity.rules" || rc=$?   # `|| rc=$?`: this hook runs under set -e; a bare grep rc=1 would exit it silently
case $rc in 0) echo "pre-commit: tools/identity.rules carries CR line endings (see .gitattributes)" >&2; exit 2 ;; 1) ;; *) echo "pre-commit: cannot read tools/identity.rules" >&2; exit 2 ;; esac
rule_of() { awk -v k="$1" '$1 == k && NF >= 2 { sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print; exit }' "$TMP/identity.rules"; }   # one process, no pipe; the value is trimmed
rule_ok() { [ -n "$1" ] || return 1; case $1 in *[[:space:]]*) return 1 ;; esac; local rc=0; printf '' | grep -qE -e "$1" || rc=$?; [ "$rc" -ne 2 ]; }   # one token, compiles
EMAIL_RE="$(rule_of email)"; NAME_BAD="$(rule_of name_bad)"
rule_ok "$EMAIL_RE" && rule_ok "$NAME_BAD" || { echo "pre-commit: tools/identity.rules must carry an 'email' and a 'name_bad' rule, one token each, that compile" >&2; exit 2; }
for role in AUTHOR COMMITTER; do
    lc="$(printf '%s' "$role" | tr 'A-Z' 'a-z')"
    ident="$(git var "GIT_${role}_IDENT")" || { echo "pre-commit: cannot determine the $lc identity" >&2; exit 2; }
    email="${ident##*<}"; email="${email%%>*}"; name="${ident%% <*}"
    [[ $email =~ $EMAIL_RE ]] || { echo "pre-commit: $lc email '$email' does not match the email rule in tools/identity.rules" >&2; exit 2; }
    if [ -z "$name" ] || [[ ${name,,} =~ $NAME_BAD ]]; then
        echo "pre-commit: $lc name must be a handle, not an address or hostname (got '$name')" >&2; exit 2
    fi
done
# staged blobs only, never the working tree; a type change (T, symlink -> file) carries a blob and counts; -z keeps a
# non-ASCII path readable (core.quotePath would C-quote it); a failing git refuses instead of reading as "nothing staged"
git diff --cached --name-only -z --diff-filter=ACMRT > "$TMP/staged.z" || { echo "pre-commit: could not list the staged files" >&2; exit 2; }
[ -s "$TMP/staged.z" ] || exit 0
command -v gitleaks >/dev/null 2>&1 || { echo "pre-commit: gitleaks is not installed — refusing to commit without the secret scan" >&2; exit 2; }
# the staged blobs are materialised at their own paths under $TMP/tree (from the INDEX, never the working tree) and
# scanned in ONE `gitleaks dir` run: paths stay known (the report names the file, the config's path allowlist for the
# two gate rules files applies), inline allow comments are ignored, no ignore file of the repository is read
git checkout-index -z --stdin --prefix="$TMP/tree/" < "$TMP/staged.z" || { echo "pre-commit: cannot read the staged blobs" >&2; exit 2; }
( cd "$TMP" && gitleaks dir "$TMP/tree" -v --redact --no-banner --no-color --ignore-gitleaks-allow --config "$ROOT/tools/gitleaks.toml" ) \
    > "$TMP/gitleaks.out" 2> "$TMP/gitleaks.err" \
    || { echo "pre-commit: gitleaks refused the staged blobs (a secret, or it could not run):" >&2; head -n 12 "$TMP/gitleaks.out" "$TMP/gitleaks.err" >&2; exit 2; }
# crossing lint over the staged blobs, public shape rules only (the identity list is private to the lane); its address
# rules cover RFC 1918 and carrier-grade ranges over the WHOLE blob, so no separate address grep is needed. Exit 1 = a
# hit, 2 = the lint could not run — both refuse, each with its own reason.
rc=0; CROSSING_LINT_GENERIC="$ROOT/tools/gate-generic.rules" bash "$ROOT/tools/crossing-lint.sh" --generic-only --staged --quiet || rc=$?   # `|| rc=$?`: this hook runs under set -e
case $rc in
    0) ;;
    1) echo "pre-commit: crossing-lint hit a private shape in the staged blobs (lines above)" >&2; exit 2 ;;
    *) echo "pre-commit: crossing-lint could not run (configuration error above, rc=$rc) — the gate fails closed" >&2; exit 2 ;;
esac
exit 0
